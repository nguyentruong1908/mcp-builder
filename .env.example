# docker compose settings. Copy to .env and adjust.

# Where the UI/API is published. Keep 127.0.0.1 unless a reverse proxy with TLS + auth sits in front:
# this version has no login, anyone who reaches the port can manage Codex credentials and builds.
MCP_BUILDER_BIND=127.0.0.1:8080
PUBLIC_URL=http://localhost:8080

POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Model allowed for the Codex account you sign in with (Settings › Codex).
CODEX_MODEL=gpt-6-sol
# danger-full-access: Codex runs without its own sandbox; the api container is the isolation boundary.
# workspace-write needs user namespaces in the container (see README "Codex sandbox trong Docker").
CODEX_SANDBOX=danger-full-access
# Optional: API key from the environment instead of signing in through the UI.
CODEX_API_KEY=

# Hosts allowed for "import spec by URL".
SPEC_FETCH_ALLOWLIST=localhost
