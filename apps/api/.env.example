DATABASE_URL="postgresql://mcp:mcp@localhost:5432/mcp_builder?schema=public"
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Where build workspaces and artifacts are stored (outside the DB)
DATA_DIR=../../data
# Codex credentials live in a platform-managed CODEX_HOME (default: $DATA_DIR/codex-home).
# Log in from the web UI (Settings › Codex): device login, API key, or upload auth.json.
# CODEX_HOME_DIR=
# Optional: an API key from the environment overrides the stored login.
# CODEX_API_KEY=
# workspace-write (default) | danger-full-access (only when the container is the sandbox)
# CODEX_SANDBOX=workspace-write
# Model must be allowed for your account.
CODEX_MODEL=gpt-6-sol
# Estimated USD per 1M tokens, used for budget enforcement and cost display
CODEX_PRICE_INPUT_PER_MTOK=1.25
CODEX_PRICE_CACHED_PER_MTOK=0.125
CODEX_PRICE_OUTPUT_PER_MTOK=10
# Comma-separated hostnames allowed for "Fetch spec by URL" (empty = deny all remote fetches except localhost)
SPEC_FETCH_ALLOWLIST=localhost,127.0.0.1

# Secrets referenced by connections as env://NAME are read from here (never stored in the DB).
# Example: a connection with secretRef env://ERP_TEST_TOKEN reads this value.
# ERP_TEST_TOKEN=
