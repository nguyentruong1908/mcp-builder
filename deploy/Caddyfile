# Behind an outer TLS proxy, trust its X-Forwarded-For so the API sees real client IPs:
# {
# 	servers {
# 		trusted_proxies static 10.0.0.0/8
# 	}
# }
# Single public entry point: UI and API on one origin (no CORS, SSE-friendly).
:80 {
	handle /api/* {
		reverse_proxy api:4000 {
			# Stream build logs (SSE) without buffering.
			flush_interval -1
		}
	}
	# Deployed MCP servers (Streamable HTTP); the API authenticates and proxies.
	handle /mcp/* {
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy web:3000
	}
}
